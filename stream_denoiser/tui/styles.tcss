$fg: #e0e0e0;
$dim: white;
$border: #1a1a1a;
$accent: #3be8ff;
$running: #6eff25ff;

Screen {
    background: transparent;
    color: $fg;
    layout: vertical;
}

Screen.-running {
    /* No global change needed, we target specific widgets */
}

#top-bar {
    height: auto;
    margin-bottom: 1;
}

#title-row {
    width: auto;
    height: 3;
}

#app-title {
    width: auto;
    color: $accent;
    height: 3;
    text-style: bold;
    content-align: left top;
}

#app-subtitle {
    width: auto;
    color: white;
    height: 3;
    content-align: left middle;
}

#title-divider {
    width: auto;
    height: 3;
    color: $accent;
    margin: 0 1;
}

/* Screen.-running #app-title {
    color: $running;
} */

/* 
Header {
    dock: top;
    background: transparent;
    color: $dim;
}

HeaderIcon {
    color: transparent;
}

HeaderTitle {
    color: $accent;
    text-style: bold;
}

Screen.-running HeaderTitle {
    color: $running;
}
*/

Footer {
    dock: bottom;
    background: transparent;
    color: #888888;
    margin-top: 1;
}

FooterKey {
    background: transparent;
    color: #888888;
    padding: 0 1;
}

FooterKey>.footer-key--key {
    background: $accent;
    color: #1a1a1a;
    text-style: bold;
    padding: 0 1;
}

FooterKey>.footer-key--description {
    padding: 0 0 0 1;
}

/* Screen.-running FooterKey>.footer-key--key {
    color: $running;
} */

#main-container {
    width: 1fr;
    height: 1fr;
}

#panels-container {
    layout: grid;
    grid-size: 2 2;
    grid-columns: 1fr 1fr;
    grid-rows: 2fr 1fr;
    grid-gutter: 1;
    width: 1fr;
    height: 1fr;
}

/* DeviceList and StatsPanel styles moved to bottom for layout grouping */

DeviceList {
    column-span: 1;
    row-span: 1;
    background: transparent;
    border: round $accent;
    border-title-color: $accent;
    border-title-background: transparent;
    border-title-style: bold;
    padding: 1;
}

VADPanel {
    column-span: 1;
    row-span: 1;
    background: transparent;
    border: round $accent;
    border-title-color: $accent;
    border-title-background: transparent;
    border-title-style: bold;
    padding: 1;
}

StatsPanel {
    column-span: 1;
    row-span: 2;
    background: transparent;
    border: round $accent;
    border-title-color: $accent;
    border-title-background: transparent;
    border-title-style: bold;
    padding: 1;
}

StatsPanel Rule {
    color: #888888;
    background: transparent;
    margin: 0 0;
}

/* Removed dynamic color for Rule to keep it static light gray */
/* 
Screen.-running StatsPanel Rule {
    color: $running;
}
*/

#stats-container {
    padding: 0 0;
}

.stat-row {
    height: 1;
    width: 1fr;
    /* This creates space between items if width is available? 
       Actually in Textual Horizontal, items stack. 
       We need 1fr on the value to push it to the right with content-align. */
}

.stat-label {
    width: auto;
    color: $dim;
}

.stat-value {
    width: 1fr;
    content-align: right middle;
    color: $accent;
}

.model-row {
    height: auto;
}

#model-block {
    width: 1fr;
    height: auto;
}

#model-block Static {
    width: 1fr;
    height: 1;
    content-align: right middle;
}

#val-model {
    color: $accent;
}

.model-sub {
    color: $accent;
}

/* Screen.-running .stat-value {
    color: $running;
} */

StatusLine {
    width: 1fr;
    height: auto;
    background: transparent;
    align: right top;
}

#status-state {
    width: 1fr;
    height: 1;
    content-align: right top;
    background: transparent;
}

#status-text {
    width: 1fr;
    height: 1;
    content-align: right top;
    background: transparent;
}

Scrollbar {
    background: transparent;
    color: $dim;
    width: 1;
}

/* Layout styles are in #panels-container grid above */

/* Narrow terminals (<100 cols): stack panels vertically with page scroll,
   drop the subtitle/divider from the title row to fit. */
Screen.-narrow #panels-container {
    layout: vertical;
    overflow-y: auto;
    grid-size: 1 1;
}

Screen.-narrow #device-panel {
    height: 11;
}

Screen.-narrow #stats-panel {
    height: 21;
}

Screen.-narrow #vad-panel {
    height: 11;
}

Screen.-narrow #app-subtitle {
    display: none;
}

Screen.-narrow #title-divider {
    display: none;
}

#vad-container {
    padding: 0 0;
}

.vad-row {
    height: 1;
    width: 1fr;
}

.vad-label {
    width: auto;
    color: $dim;
}

.vad-value {
    width: 1fr;
    content-align: right middle;
    color: $accent;
}

.vad-status {
    width: 1fr;
    content-align: right middle;
    color: $accent;
}

.vad-hint {
    width: 1fr;
    content-align: center middle;
    color: #888888;
}

.vad-bar {
    width: 1fr;
    content-align: center middle;
    color: $accent;
}