$fg: #e0e0e0;
$dim: white;
$border: #1a1a1a;
$accent: #3be8ff;
$running: #6eff25ff;

/* Base background for the whole app: the terminal default, so the app
   blends with the terminal instead of painting a dark rectangle.
   NOTE: `transparent` does NOT work for base filler — filler cells drop
   the alpha channel when converted to terminal colors and render as solid
   black. `ansi_default` emits the terminal default background instead.
   The `*` rule covers containers with no explicit background; anything
   sitting over an opaque parent (modal dialog content, highlight rows)
   keeps its own `transparent`, which blends correctly down to the parent
   (those rules live in the widget DEFAULT_CSS and beat `*` anyway). */
* {
    background: ansi_default;
}

/* State and surface rules that widget DEFAULT_CSS used to provide.
   They must live here: app CSS beats widget DEFAULT_CSS for the same
   property, so the `*` rule above would otherwise swallow them. */
ModelPickerScreen > Vertical {
    background: #1a1a1a;
}

ModelPickerScreen ListView {
    background: #1a1a1a;
}

ModelPickerScreen ListItem {
    background: #1a1a1a;
}

ModelPickerScreen Label {
    background: #1a1a1a;
}

ModelPickerScreen ListItem.-hovered {
    background: $block-hover-background;
}

ModelPickerScreen ListItem.-highlight {
    background: $accent;
    color: #1a1a1a;
}

ModelPickerScreen ListItem.-highlight > Label {
    background: $accent;
    color: #1a1a1a;
}

#device-list ListItem.-hovered {
    background: $block-hover-background;
}

#device-list ListItem.-highlight {
    background: $accent;
    color: #1a1a1a;
}

#device-list ListItem.-highlight > Label {
    background: $accent;
    color: #1a1a1a;
}

/* The App node paints the screen base via App.render() (Screen defers to
   it when it has no opaque background of its own). Textual's default App
   background is the opaque $background theme color — override it or the
   whole app is a dark block against the terminal. */
PoiseApp {
    background: ansi_default;
}

Screen {
    background: ansi_default;
    color: $fg;
    layout: vertical;
}

Screen.-running {
    /* No global change needed, we target specific widgets */
}

#top-bar {
    height: auto;
    margin-bottom: 1;
}

#title-row {
    width: auto;
    height: 3;
}

#app-title {
    width: auto;
    color: $accent;
    height: 3;
    text-style: bold;
    content-align: left top;
}

#app-subtitle {
    width: auto;
    color: white;
    height: 3;
    content-align: left middle;
}

#title-divider {
    width: auto;
    height: 3;
    color: $accent;
    margin: 0 1;
}

/* Screen.-running #app-title {
    color: $running;
} */

/* 
Header {
    dock: top;
    background: transparent;
    color: $dim;
}

HeaderIcon {
    color: transparent;
}

HeaderTitle {
    color: $accent;
    text-style: bold;
}

Screen.-running HeaderTitle {
    color: $running;
}
*/

Footer {
    dock: bottom;
    background: ansi_default;
    color: #888888;
    margin-top: 1;
}

FooterKey {
    background: ansi_default;
    color: #888888;
    padding: 0 1;
}

FooterKey>.footer-key--key {
    background: $accent;
    color: #1a1a1a;
    text-style: bold;
    padding: 0 1;
}

/* NOTE: bare `.footer-key--*` selectors feed FooterKey's render-time
   component styles (older Textual renders key/description as Text spans,
   not child widgets, so descendant selectors match nothing there). */
.footer-key--description,
FooterKey>.footer-key--description {
    padding: 0 0 0 1;
    color: $fg;
    background: ansi_default;
}

/* Screen.-running FooterKey>.footer-key--key {
    color: $running;
} */

#main-container {
    width: 1fr;
    height: 1fr;
}

#panels-container {
    layout: grid;
    grid-size: 2 2;
    grid-columns: 1fr 1fr;
    grid-rows: 2fr 1fr;
    grid-gutter: 1;
    width: 1fr;
    height: 1fr;
}

/* DeviceList and StatsPanel styles moved to bottom for layout grouping */

DeviceList {
    column-span: 1;
    row-span: 1;
    background: ansi_default;
    border: round $accent;
    border-title-color: $accent;
    border-title-background: transparent;
    border-title-style: bold;
    padding: 1;
}

/* ListView paints $surface by default — keep the panel on terminal bg. */
#device-list {
    background: ansi_default;
}

#device-list ListItem {
    background: ansi_default;
}

#device-list ListItem Label {
    background: ansi_default;
}

DeviceListItem {
    background: ansi_default;
}

DeviceListItem Label {
    background: ansi_default;
}

VADPanel {
    column-span: 1;
    row-span: 1;
    background: ansi_default;
    border: round $accent;
    border-title-color: $accent;
    border-title-background: transparent;
    border-title-style: bold;
    padding: 1;
}

StatsPanel {
    column-span: 1;
    row-span: 2;
    background: ansi_default;
    border: round $accent;
    border-title-color: $accent;
    border-title-background: transparent;
    border-title-style: bold;
    padding: 1;
}

StatsPanel Rule {
    color: #888888;
    background: ansi_default;
    margin: 0 0;
}

/* Removed dynamic color for Rule to keep it static light gray */
/* 
Screen.-running StatsPanel Rule {
    color: $running;
}
*/

#stats-container {
    padding: 0 0;
}

.stat-row {
    height: 1;
    width: 1fr;
    /* This creates space between items if width is available? 
       Actually in Textual Horizontal, items stack. 
       We need 1fr on the value to push it to the right with content-align. */
}

.stat-label {
    width: auto;
    color: $dim;
}

.stat-value {
    width: 1fr;
    content-align: right middle;
    color: $accent;
}

.model-row {
    height: auto;
}

#model-block {
    width: 1fr;
    height: auto;
}

#model-block Static {
    width: 1fr;
    height: 1;
    content-align: right middle;
}

#val-model {
    color: $accent;
}

.model-sub {
    color: $accent;
}

/* Screen.-running .stat-value {
    color: $running;
} */

StatusLine {
    width: 1fr;
    height: auto;
    background: ansi_default;
    align: right top;
}

#status-state {
    width: 1fr;
    height: 1;
    content-align: right top;
    background: ansi_default;
}

#status-text {
    width: 1fr;
    height: 1;
    content-align: right top;
    background: ansi_default;
}

Scrollbar {
    background: ansi_default;
    color: $dim;
    width: 1;
}

/* Layout styles are in #panels-container grid above */

/* Narrow terminals (<100 cols): stack panels vertically with page scroll,
   drop the subtitle/divider from the title row to fit. */
Screen.-narrow #panels-container {
    layout: vertical;
    overflow-y: auto;
    grid-size: 1 1;
}

Screen.-narrow #device-panel {
    height: 11;
}

Screen.-narrow #stats-panel {
    height: 21;
}

Screen.-narrow #vad-panel {
    height: 11;
}

Screen.-narrow #app-subtitle {
    display: none;
}

Screen.-narrow #title-divider {
    display: none;
}

#vad-container {
    padding: 0 0;
}

.vad-row {
    height: 1;
    width: 1fr;
}

.vad-label {
    width: auto;
    color: $dim;
}

.vad-value {
    width: 1fr;
    content-align: right middle;
    color: $accent;
}

.vad-status {
    width: 1fr;
    content-align: right middle;
    color: $accent;
}

.vad-hint {
    width: 1fr;
    content-align: center middle;
    color: #888888;
}

.vad-bar {
    width: 1fr;
    content-align: center middle;
    color: $accent;
}