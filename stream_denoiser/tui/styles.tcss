/* The "Monitor" design. Colors are $poise-<role> variables from the
   app's palette (palette.py), so a theme or the user's own colors
   reach the stylesheet too. */

/* Base background for the whole app: the terminal default, so the app
   blends with the terminal instead of painting a dark rectangle.
   NOTE: `transparent` does NOT work for base filler — filler cells drop
   the alpha channel when converted to terminal colors and render as solid
   black. `ansi_default` emits the terminal default background instead.
   The `*` rule covers containers with no explicit background; anything
   sitting over an opaque parent (modal dialog content, highlight rows)
   keeps its own `transparent`, which blends correctly down to the parent
   (those rules live in the widget DEFAULT_CSS and beat `*` anyway). */
* {
    background: ansi_default;
}

/* State and surface rules that widget DEFAULT_CSS used to provide.
   They must live here: app CSS beats widget DEFAULT_CSS for the same
   property, so the `*` rule above would otherwise swallow them. */
ModelPickerScreen > Vertical,
ModelPickerScreen ListView,
ModelPickerScreen ListItem,
ModelPickerScreen Horizontal,
ModelPickerScreen Label {
    background: $poise-surface;
}

ModelPickerScreen ListItem.-hovered,
ModelPickerScreen ListItem.-hovered Horizontal,
ModelPickerScreen ListItem.-hovered Label {
    background: $poise-selection;
}

/* The highlighted model: filled with the accent, dark text. */
ModelPickerScreen ListItem.-highlight,
ModelPickerScreen ListItem.-highlight Horizontal,
ModelPickerScreen ListItem.-highlight Label {
    background: $poise-accent;
    color: $poise-on-accent;
}

ModelPickerScreen ListItem.-highlight .model-head Label {
    text-style: bold;
}

/* Textual's cursor bolds the whole item; only the name is bold here. */
ModelPickerScreen ListView > ListItem.-highlight {
    text-style: none;
}

/* No focus tint: it shows between the rows. */
ModelPickerScreen ListView:focus {
    background-tint: 0%;
}

/* The App node paints the screen base via App.render() (Screen defers to
   it when it has no opaque background of its own). Textual's default App
   background is the opaque $background theme color — override it or the
   whole app is a dark block against the terminal. */
PoiseApp {
    background: ansi_default;
}

Screen {
    background: ansi_default;
    color: $poise-text;
    layout: vertical;
}

/* The model picker dims the screen behind it. After the Screen rule,
   which would otherwise make it opaque (same specificity). */
ModelPickerScreen {
    background: $poise-scrim 55%;
}

#main {
    height: 1fr;
}

/* Every panel. The title's line run (box.py) takes border-title-color,
   so it must equal the border color in each state. */
Box {
    border: round $poise-border;
    border-title-color: $poise-border;
    border-title-background: transparent;
    padding: 1 1 0 1;
}

Box:focus-within {
    border: round $poise-accent;
    border-title-color: $poise-accent;
}

#signal-panel {
    height: auto;
    padding: 0 1 1 1;
}

#signal-body {
    height: auto;
}

LevelScope {
    width: 1fr;
    height: 13;
}

SessionStats {
    width: 34;
    height: auto;
    margin-left: 2;
    padding-left: 2;
    border-left: solid $poise-groove;
}

#bottom-row {
    height: 1fr;
}

#bottom-row > Box {
    width: 1fr;
    height: 1fr;
}

#isolation-body {
    width: 1fr;
}

/* ListView paints $surface by default — keep the panel on terminal bg. */
#device-list {
    height: auto;
    max-height: 1fr;
    background: ansi_default;
}

#device-list ListItem {
    background: ansi_default;
}

#device-list ListItem Label {
    background: ansi_default;
}

#device-list:focus ListItem.-highlight {
    background: $poise-selection;
}

#device-list ListItem.-highlight > Label {
    background: transparent;
}

#device-list:focus ListItem.-highlight > Label {
    background: $poise-selection;
}

#device-note {
    margin-top: 1;
}

#events-body {
    width: 1fr;
    height: 1fr;
    overflow: hidden;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

KeyBar {
    height: 1;
    width: 1fr;
}

Scrollbar {
    background: ansi_default;
    color: $poise-muted;
    width: 1;
}

/* Narrow terminals (<100 cols): the stats go under the scope, the
   boxes stack and the page scrolls. */
Screen.-narrow #main {
    overflow-y: auto;
    scrollbar-size-vertical: 1;
    scrollbar-color: $poise-border;
    scrollbar-color-hover: $poise-muted;
    scrollbar-color-active: $poise-accent;
    scrollbar-background: ansi_default;
    scrollbar-background-hover: ansi_default;
    scrollbar-background-active: ansi_default;
}

Screen.-narrow #signal-body {
    layout: vertical;
}

Screen.-narrow SessionStats {
    width: 1fr;
    margin: 1 0 0 0;
    padding-left: 0;
    border-left: none;
}

Screen.-narrow #bottom-row {
    layout: vertical;
    height: auto;
}

Screen.-narrow #bottom-row > Box {
    height: auto;
    /* All four sides: a lone padding-bottom zeroes the others. */
    padding: 1 1 1 1;
}

Screen.-narrow #events-panel {
    height: 9;
}
