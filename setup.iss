; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

#define MyAppName "Poise Voice Isolator"
; CI passes the release's version (ISCC /DMyAppVersion=X.Y.Z, checked
; against pyproject.toml); this default only serves local builds.
#ifndef MyAppVersion
  #define MyAppVersion "1.5.0"
#endif
#define MyAppPublisher "chabandou"
#define MyAppURL "https://github.com/chabandou/Poise-Voice-Isolator"
#define MyAppExeName "Poise.exe"

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{D37E2F8B-563C-4D2A-B96E-6F8FA7D3F6A7}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
; Shown in Add/Remove Programs and in the installer's Properties > Details.
; Credit only: SmartScreen goes by a code signature, not by these fields.
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}/issues
AppCopyright=Copyright (c) 2026 {#MyAppPublisher}
DefaultDirName={autopf}\{#MyAppName}
DisableProgramGroupPage=yes
; Uncomment the following line to run in non administrative install mode (install for current user only.)
;PrivilegesRequired=lowest
OutputDir=installer
; Two builds share this script:
;   (default)  Poise_Setup.exe - the plain Inno installer, kept working
;              as a fallback and for CI smoke checks.
;   /DCORE    PoiseCore.exe    - the silent engine behind Poise_Setup.exe,
;              which is now the PyQt setup window (installer/bootstrapper).
#ifdef CORE
OutputBaseFilename=PoiseCore
#else
OutputBaseFilename=Poise_Setup
#endif
SetupIconFile=stream_denoiser\gui\assets\icon-setup.ico
; lzma2 at its strongest setting: a few percent smaller than plain lzma
; for the same payload, at the cost of a slower compile.
Compression=lzma2/ultra64
SolidCompression=yes
WizardStyle=modern
InfoBeforeFile=installer\windows\vbcable-notice.txt
; Files in use (Poise, or its audio process) are closed through the
; Restart Manager; silent runs need /CLOSEAPPLICATIONS for it.
CloseApplications=yes

[InstallDelete]
; The PyInstaller runtime is replaced whole on every install: modules and
; DLLs a newer build dropped must not linger next to the new ones.
Type: filesandordirs; Name: "{app}\_internal"

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "dist\Poise\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion
Source: "dist\Poise\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
; NOTE: Don't use "Flags: ignoreversion" on any shared system files
; PyInstaller >= 6 stages datas under dist\Poise\_internal\ (older layouts
; put them in dist\Poise\ directly). Remap the driver pack to a stable
; {app}\vbcable so the [Code] driver install below finds it regardless.
; Skipped silently when the source dir is absent (old layout: the blanket
; copy above already covers dist\Poise\vbcable\).
Source: "dist\Poise\_internal\vbcable\*"; DestDir: "{app}\vbcable"; Flags: ignoreversion recursesubdirs createallsubdirs skipifsourcedoesntexist

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent
; An in-app update starts Poise again from DeinitializeSetup instead,
; whether the install worked or not.

[Code]
const
  { Held by a running Poise (stream_denoiser/updates.py RUNNING_MUTEX). }
  RunningMutex = 'PoiseVoiceIsolatorRunning';
  { How long an update waits for Poise to quit (it stops isolating and
    restores the default playback device first), then for Windows to
    release the mutex once it has been closed by force. }
  QuitWaitMs = 30000;
  KillWaitMs = 5000;

var
  VbcableNeedsReboot: Boolean;
  { An update made Poise quit: it must be started again on the way out,
    on success (the new version) and on failure (whatever is there). }
  RelaunchPoise: Boolean;

{ In-app updates pass /POISEUPDATE=<file>: the file Poise watches to
  learn that this (elevated) setup is running and it should quit. }
function UpdateSignalPath(): String;
begin
  Result := ExpandConstant('{param:POISEUPDATE|}');
end;

function IsPoiseUpdate(): Boolean;
begin
  Result := UpdateSignalPath() <> '';
end;

{ Wait up to TimeoutMs for every Poise to be gone. }
function WaitForPoiseToQuit(TimeoutMs: Integer): Boolean;
var
  Waited: Integer;
begin
  Waited := 0;
  while CheckForMutexes(RunningMutex) and (Waited < TimeoutMs) do
  begin
    Sleep(250);
    Waited := Waited + 250;
  end;
  Result := not CheckForMutexes(RunningMutex);
  if Result then
    Log(Format('Poise: quit after %d ms', [Waited]));
end;

{ The Poise that asked for this update (its /POISEPID), with its audio
  process. Only ever that process: other users' Poise stay untouched. }
procedure ClosePoiseByForce();
var
  Pid: String;
  ResultCode: Integer;
begin
  Pid := ExpandConstant('{param:POISEPID|}');
  if (Pid = '') or (StrToIntDef(Pid, 0) <= 0) then
  begin
    Log('Poise: no /POISEPID to close');
    Exit;
  end;
  Log('Poise: still running, closing pid ' + Pid);
  Exec(ExpandConstant('{sys}\taskkill.exe'), '/F /T /PID ' + Pid, '',
    SW_HIDE, ewWaitUntilTerminated, ResultCode);
  Log(Format('Poise: taskkill exited with code %d', [ResultCode]));
end;

function InitializeSetup(): Boolean;
begin
  Result := True;
  if IsPoiseUpdate() then
  begin
    if not SaveStringToFile(UpdateSignalPath(), 'started', False) then
      Log('Poise: could not write the update signal file');
    { Poise quits as soon as it sees the signal. One that hangs on the
      way out is closed by force: installing over a running Poise would
      leave a half-replaced _internal that does not start. }
    if not WaitForPoiseToQuit(QuitWaitMs) then
    begin
      ClosePoiseByForce();
      if not WaitForPoiseToQuit(KillWaitMs) then
      begin
        Log('Poise: still running, update abandoned');
        Result := False;
        Exit;
      end;
    end;
    RelaunchPoise := True;
    Exit;
  end;
  { A manual install over a running Poise: it hides in the tray when its
    window closes, so the Restart Manager alone cannot close it. }
  while CheckForMutexes(RunningMutex) and not WizardSilent() do
    if MsgBox('Poise is running. Quit it from its tray icon menu, ' +
        'then click OK to continue.', mbInformation, MB_OKCANCEL) = IDCANCEL then
    begin
      Result := False;
      Exit;
    end;
end;

{ This Setup is 32-bit: a plain powershell.exe is the SysWOW64 one, whose
  HKLM\SOFTWARE is the 32-bit view - no MMDevices there, so CABLE always
  looked missing and the driver setup ran on every install and update. }
function PowerShellExe(): String;
begin
  if IsWin64 then
    Result := ExpandConstant('{sysnative}\WindowsPowerShell\v1.0\powershell.exe')
  else
    Result := 'powershell.exe';
end;

{ Scan the MMDevices registry for a CABLE Input render endpoint.
  Needs no AudioDeviceCmdlets module, so it works on fresh machines.
  Running the VB-Cable setup while already installed offers REMOVAL,
  so this gate must stay: never run the setup blindly. }
function NeedsVbcableInstall(): Boolean;
var
  PsPath, OutPath: String;
  { SaveStringToFile/LoadStringFromFile take AnsiString (var param needs an
    exact-type match, so plain String fails compile with "Type mismatch"). }
  Script, Output: AnsiString;
  ResultCode: Integer;
begin
  Result := True;
  PsPath := ExpandConstant('{tmp}\poise_vbcable_detect.ps1');
  OutPath := ExpandConstant('{tmp}\poise_vbcable_detect.txt');
  Script :=
    '$names = Get-ChildItem ''HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\MMDevices\Audio\Render'' -ErrorAction SilentlyContinue | ForEach-Object {' + #13#10 +
    '    $p = $_.PSPath + ''\Properties'';' + #13#10 +
    '    (Get-ItemProperty -Path $p -Name ''{a45c254e-df1c-4efd-8020-67d146a850e0},2'' -ErrorAction SilentlyContinue).''{a45c254e-df1c-4efd-8020-67d146a850e0},2''' + #13#10 +
    '};' + #13#10 +
    '$found = $names | Where-Object { $_ -like ''CABLE Input*'' };' + #13#10 +
    'if ($found) { $verdict = ''CABLE-PRESENT'' } else { $verdict = ''CABLE-MISSING'' };' + #13#10 +
    'Out-File -FilePath ''' + OutPath + ''' -InputObject $verdict -Encoding ascii;' + #13#10;
  if not SaveStringToFile(PsPath, Script, False) then
    Exit;
  if not Exec(PowerShellExe(),
      '-NoProfile -NonInteractive -ExecutionPolicy Bypass -File "' + PsPath + '"',
      '', SW_HIDE, ewWaitUntilTerminated, ResultCode) then
    Exit;
  if LoadStringFromFile(OutPath, Output) then
    Result := Pos('CABLE-PRESENT', Output) = 0;
  { Fail closed: any detection failure reports "no install needed" so a
    broken probe can never trigger the setup's removal-offer path. The
    in-app Install button remains as fallback. }
  if Result then
    Log('Poise: CABLE endpoints missing, VB-Cable setup will run')
  else
    Log('Poise: CABLE endpoints present, skipping VB-Cable setup');
end;

{ Silent-install the vendored driver after files land, only when CABLE
  is missing. 3010/1641 mean "installed, reboot to activate". }
procedure CurStepChanged(CurStep: TSetupStep);
var
  SetupExe: String;
  ResultCode: Integer;
begin
  { Progress markers for the setup window (installer/bootstrapper). It
    runs this script silently, so these log lines are the only way it can
    see progress: keep the format in step with core.py's parse_marker. }
  if CurStep = ssInstall then
  begin
    Log('POISE:phase=files');
    Exit;
  end;
  if CurStep = ssDone then
  begin
    Log('POISE:phase=finish');
    Exit;
  end;
  if CurStep <> ssPostInstall then
    Exit;
  Log('POISE:phase=driver');
  { Canonical location (remapped by [Files] above); fall back to the raw
    PyInstaller >= 6 layout in case the remap was skipped. }
  SetupExe := ExpandConstant('{app}\vbcable\VBCABLE_Setup_x64.exe');
  if not FileExists(SetupExe) then
    SetupExe := ExpandConstant('{app}\_internal\vbcable\VBCABLE_Setup_x64.exe');
  if not FileExists(SetupExe) then
  begin
    Log('Poise: vendored VB-Cable setup not found, skipping driver install');
    Log('POISE:driver=skip');
    Exit;
  end;
  if not NeedsVbcableInstall() then
  begin
    Log('POISE:driver=skip');
    Exit;
  end;
  Log('POISE:driver=install');
  Log('Poise: running vendored VB-Cable setup (silent)');
  { Run from the setup's own directory: it resolves its sibling driver
    files (.sys/.cat/.inf) relative to the working directory. }
  if Exec(SetupExe, '-i -h', ExtractFileDir(SetupExe),
      SW_HIDE, ewWaitUntilTerminated, ResultCode) then
  begin
    Log(Format('Poise: VB-Cable setup exited with code %d', [ResultCode]));
    if (ResultCode = 3010) or (ResultCode = 1641) then
    begin
      VbcableNeedsReboot := True;
      Log('POISE:driver=reboot');
    end
    else
      Log('POISE:driver=done');
  end
  else
  begin
    Log('Poise: failed to launch VB-Cable setup');
    Log('POISE:driver=failed');
  end;
end;

function NeedRestart(): Boolean;
begin
  Result := VbcableNeedsReboot;
end;

{ Runs however Setup ends. After an update, start Poise again as the
  user (not elevated): the new version, or the old one if the install
  failed - Poise then sees its version did not change and says so. }
procedure DeinitializeSetup();
var
  Exe: String;
  ResultCode: Integer;
begin
  if not RelaunchPoise then
    Exit;
  try
    Exe := ExpandConstant('{app}\{#MyAppExeName}');
  except
    Log('Poise: install folder unknown, cannot start Poise again');
    Exit;
  end;
  if not FileExists(Exe) then
  begin
    Log('Poise: ' + Exe + ' is missing, cannot start Poise again');
    Exit;
  end;
  if ExecAsOriginalUser(Exe, '', ExtractFileDir(Exe), SW_SHOWNORMAL,
      ewNoWait, ResultCode) then
    Log('Poise: started again after the update')
  else
    Log(Format('Poise: could not start again (%d)', [ResultCode]));
end;
